{
  "name": "kingjuan-ranking",
  "version": "1.0.0",
  "description": "The King Juan Soccer ranking rule — how youth soccer teams around Seattle are rated from their league level, their results and their trophies, and how leagues and tournament flights are tiered.",
  "license": "MIT",
  "repository": "github:sidbai/kingjuan-ranking",
  "homepage": "https://kingjuansoccer.com/rankings",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js", "default": "./dist/index.js" }
  },
  "files": ["dist", "fixtures", "README.md", "LICENSE"],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p .",
    "evaluate": "tsx scripts/evaluate.ts"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  },
  "packageManager": "pnpm@10.15.0"
}
